# Public build-time browser values; never put secrets here.
# Docker: both HTTP and WebSocket traffic go through Nginx on port 3000.
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=localhost:3000
# Container-only upstream, with no trailing slash or path.
BACKEND_URL=http://host.docker.internal:3001
# For yarn start, use REACT_APP_WS_URL=localhost:3001 instead.
